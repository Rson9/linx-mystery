{
  "name": "linx-mystery",
  "version": "0.3.0",
  "main": "desktop/main.mjs",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "type": "module",
  "description": "谜声：可通过灵矽语音游玩的情境推理游戏",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "pet": "node --env-file-if-exists=.env scripts/pet.mjs",
    "pet:open": "node --env-file-if-exists=.env scripts/pet.mjs open",
    "pet:web": "node --env-file-if-exists=.env scripts/pet.mjs --web",
    "desktop": "node --env-file-if-exists=.env scripts/desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:check": "node scripts/check-desktop.mjs",
    "desktop:check:live": "node --env-file-if-exists=.env scripts/check-desktop-live.mjs",
    "pet:check": "node --env-file-if-exists=.env scripts/check-pet.mjs",
    "library:check": "node scripts/check-library-data.mjs",
    "library:check:live": "node --env-file-if-exists=.env scripts/check-library.mjs",
    "check": "pnpm library:check && pnpm test && pnpm test:e2e",
    "package": "node scripts/package.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "mcp:check": "node --env-file-if-exists=.env scripts/check-mcp.mjs",
    "eval:host": "node --env-file-if-exists=.env scripts/eval-host.mjs",
    "voice:setup": "node scripts/voice.mjs setup",
    "voice:activate": "node scripts/voice.mjs activate",
    "voice:check": "node scripts/voice.mjs check",
    "voice:probe": "node scripts/voice.mjs probe",
    "voice:smoke": "node scripts/voice.mjs smoke",
    "voice:playtest": "node scripts/voice.mjs playtest",
    "voice:start": "node scripts/voice.mjs start",
    "voice:test": "node scripts/voice.mjs test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "ws": "8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.64.1",
    "electron": "44.9.3"
  }
}
