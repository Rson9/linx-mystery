# 本地试玩无需填写任何密钥。推荐 Node.js 24+。
HOST=127.0.0.1
PORT=3210
# 对外部署时填准确的 HTTPS origin（无末尾斜杠），并通过反向代理提供 TLS。
PUBLIC_ORIGIN=
# 平台回调和 MCP 共用的服务端令牌，至少 32 字节随机值。
# 生成：openssl rand -hex 32；与灵矽配置中的 Authorization 保持一致。
LINX_SERVICE_TOKEN=
# 排查 MCP 时临时设为 1；只记录状态/认证是否匹配，不记录令牌、身份或参数。
MCP_DIAGNOSTICS=0
# AI 主持默认关闭，先配置模型并运行 pnpm eval:host，通过质量门槛后再设 1。
# 设为 1 时使用基于固定真相的真假判定与语义判题；模型故障不降级泄露线索，也不扣次数。
AI_HOST_ENABLED=0
# OpenAI-compatible API 的 /v1 地址、密钥和模型名称。仅在服务端使用。
# 关闭时仍为旧规则演示，不等同于具备自由问答能力。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选推理强度，供应商支持时可填 low；留空使用供应商默认值。
LLM_REASONING_EFFORT=
# 默认 data/games.sqlite。生产环境应挂载持久卷。
# DB_PATH=/data/games.sqlite
