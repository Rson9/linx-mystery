# 推荐 Node.js 24+。语音入口需配置服务令牌、灵矽 Agent 与设备绑定。
# 独立文字模式不需要平台配置。
HOST=127.0.0.1
PORT=3210
# 桌宠独立端口，仅绑定 127.0.0.1。不要把这个端口通过 frp 暴露公网。
PET_PORT=3212
# 默认读取本机 PORT 对应的游戏服务；只有改用其他可信服务时才设置。
# PET_GAME_ORIGIN=http://127.0.0.1:3210
# 对外部署时填准确的 HTTPS origin（无末尾斜杠），并通过反向代理提供 TLS。
PUBLIC_ORIGIN=
# 平台回调和 MCP 共用的服务端令牌，至少 32 字节随机值。
# 生成：openssl rand -hex 32；与灵矽配置中的 Authorization 保持一致。
LINX_SERVICE_TOKEN=
# 排查 MCP 时临时设为 1；只记录状态/认证是否匹配，不记录令牌、身份或参数。
MCP_DIAGNOSTICS=0
# AI 主持默认关闭，先配置模型并运行 pnpm eval:host，通过质量门槛后再设 1。
# 设为 1 时使用基于固定真相的真假判定与语义判题；模型故障不降级泄露线索，也不扣次数。
AI_HOST_ENABLED=0
# 复用灵矽 Agent 模型：MCP 两阶段主持，不调用上面的独立模型接口。
# 设为 1 后需在平台刷新工具，出现 mystery_commit，并更新 docs/agent-host-prompt.txt。
# 网页仍按 AI_HOST_ENABLED 独立选择模式，不向浏览器提供内部主持资料。
LINX_AGENT_HOST_ENABLED=1
# OpenAI-compatible API 的 /v1 地址、密钥和模型名称。仅在服务端使用。
# 此独立裁判关闭时，文字页面使用有限规则判定；桌面语音由灵矽 Agent 处理。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选推理强度，供应商支持时可填 low；留空使用供应商默认值。
LLM_REASONING_EFFORT=
# 默认 data/games.sqlite。生产环境应挂载持久卷。
# DB_PATH=/data/games.sqlite
