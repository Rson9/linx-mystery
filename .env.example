# 本地试玩无需填写任何密钥。推荐 Node.js 24+。
HOST=127.0.0.1
PORT=3210
# 对外部署时填准确的 HTTPS origin（无末尾斜杠），并通过反向代理提供 TLS。
PUBLIC_ORIGIN=
# 平台回调和 MCP 共用的服务端令牌，至少 32 字节随机值。
# 生成：openssl rand -hex 32；与灵矽配置中的 Authorization 保持一致。
LINX_SERVICE_TOKEN=
# 可选：OpenAI-compatible API 的 /v1 地址。仅用于问题 → 已审核事实编号的语义路由。
# 留空使用关键词规则，无法判断的问题明确拒答。不会调用模型判定通关。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 默认 data/games.sqlite。生产环境应挂载持久卷。
# DB_PATH=/data/games.sqlite
